// good test case
// main method return value: 0
// gc stress heap: 65536
class Main ( String empty; ) [ Main() { ; } ] {
    void leaf() {
        String scratch;
        scratch = ("x" * 16384);
        if ((scratch = ("x" * 16384))) { ; }
        else { out.print_bool(false); out.println(); }
        scratch = empty;
    }
    void phase1() {
        this.leaf();
        this.leaf();
        this.leaf();
        this.leaf();
        this.leaf();
        this.leaf();
        this.leaf();
        this.leaf();
    }
    void phase2() {
        this.phase1();
        this.phase1();
        this.phase1();
        this.phase1();
        this.phase1();
        this.phase1();
        this.phase1();
        this.phase1();
    }
    void phase3() {
        this.phase2();
        this.phase2();
        this.phase2();
        this.phase2();
        this.phase2();
        this.phase2();
        this.phase2();
        this.phase2();
    }
    void phase4() {
        this.phase3();
        this.phase3();
        this.phase3();
        this.phase3();
        this.phase3();
        this.phase3();
        this.phase3();
        this.phase3();
    }
    void churn(String arg0, String arg1) {
        this.phase4();
        out.print_bool((arg0 = "xxxx")); out.println();
        out.print_bool((arg1 = "xxxxxxxxxxxxxxxxxxxx")); out.println();
        arg0 = empty;
    }
    int main() {
        String older; String ordinary; String alias;
        older = ("x" * 8);
        ordinary = ("x" * 12);
        alias = ordinary;
        ordinary = ("x" * 20);
        this.churn("xxxx", ordinary);
        out.print_bool((older = "xxxxxxxx")); out.println();
        out.print_bool((alias = "xxxxxxxxxxxx")); out.println();
        out.print_bool((ordinary = "xxxxxxxxxxxxxxxxxxxx")); out.println();
        ordinary = empty;
        alias = empty;
        return 0;
    }
}
