// runtime abort test case
// expected exit code: 137
// expected stderr substring: lo_alloc: out of memory
// gc stress heap: 65536
class Main () [ Main() { ; } ] {
    int main() {
        String a; String b; String c; String d; String e;
        a = ("x" * 4194304);
        b = ("x" * 4194304);
        c = ("x" * 4194304);
        d = ("x" * 4194304);
        e = ("x" * 4194304);
        // Keep every string observable after the final allocation.
        // Any normal return is a failure for this expected-abort test.
        if ((a = "")) { return 1; } else { ; }
        if ((b = "")) { return 1; } else { ; }
        if ((c = "")) { return 1; } else { ; }
        if ((d = "")) { return 1; } else { ; }
        if ((e = "")) { return 1; } else { ; }
        return 2;
    }
}
