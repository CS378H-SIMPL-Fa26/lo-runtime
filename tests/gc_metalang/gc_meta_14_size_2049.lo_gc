# Neighbor-size comparison against case 06 (2048 bytes); identical root schedule.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func main 0
    alloc 2049 anchor0
    alloc 2049 anchor1
    alloc 2049 anchor2
    alloc 2049 anchor3
    alloc 2049 anchor4
    alloc 2049 anchor5
    alloc 2049 anchor6
    alloc 2049 anchor7
