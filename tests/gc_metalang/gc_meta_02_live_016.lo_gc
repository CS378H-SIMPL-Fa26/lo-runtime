# Persistent-set ladder: 16 x 512-byte anchors, identical churn.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func main 0
    alloc 512 anchor0
    alloc 512 anchor1
    alloc 512 anchor2
    alloc 512 anchor3
    alloc 512 anchor4
    alloc 512 anchor5
    alloc 512 anchor6
    alloc 512 anchor7
    alloc 512 anchor8
    alloc 512 anchor9
    alloc 512 anchor10
    alloc 512 anchor11
    alloc 512 anchor12
    alloc 512 anchor13
    alloc 512 anchor14
    alloc 512 anchor15
    call phase4
end
