# Three lifetime classes; expire short and medium cohorts while persistent data survives.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func main 0
    alloc 4096 permanent
    alloc 8192 medium
    alloc 4096 short
    call phase3
    short = null
    alloc 4096 short
    call phase3
    short = null
    alloc 4096 short
    call phase3
    short = null
    alloc 4096 short
    call phase3
    short = null
    medium = null
    call phase4
    permanent = null
end
