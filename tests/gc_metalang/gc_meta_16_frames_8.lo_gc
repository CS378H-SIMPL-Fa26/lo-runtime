# Fixed 32 KiB retained across 8 suspended frames; repeated retirement.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func frame0 0
    alloc 4096 local
    call frame1
end

func frame1 0
    alloc 4096 local
    call frame2
end

func frame2 0
    alloc 4096 local
    call frame3
end

func frame3 0
    alloc 4096 local
    call frame4
end

func frame4 0
    alloc 4096 local
    call frame5
end

func frame5 0
    alloc 4096 local
    call frame6
end

func frame6 0
    alloc 4096 local
    call frame7
end

func frame7 0
    alloc 4096 local
    call phase4
end

func main 0
    call frame0
    call frame0
end
