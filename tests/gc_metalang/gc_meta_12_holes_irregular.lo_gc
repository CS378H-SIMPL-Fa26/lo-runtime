# Dead regions before survivors; vary gap lengths.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func main 0
    alloc 127 dead0
    alloc 1024 live0
    alloc 1025 dead1
    alloc 1024 live1
    alloc 8191 dead2
    alloc 1024 live2
    alloc 4097 dead3
    alloc 1024 live3
    alloc 127 dead4
    alloc 1024 live4
    alloc 1025 dead5
    alloc 1024 live5
    alloc 8191 dead6
    alloc 1024 live6
    alloc 4097 dead7
    alloc 1024 live7
    alloc 127 dead8
    alloc 1024 live8
    alloc 1025 dead9
    alloc 1024 live9
    alloc 8191 dead10
    alloc 1024 live10
    alloc 4097 dead11
    alloc 1024 live11
    alloc 127 dead12
    alloc 1024 live12
    alloc 1025 dead13
    alloc 1024 live13
    alloc 8191 dead14
    alloc 1024 live14
    alloc 4097 dead15
    alloc 1024 live15
    dead0 = null
    dead1 = null
    dead2 = null
    dead3 = null
    dead4 = null
    dead5 = null
    dead6 = null
    dead7 = null
    dead8 = null
    dead9 = null
    dead10 = null
    dead11 = null
    dead12 = null
    dead13 = null
    dead14 = null
    dead15 = null
    call phase4
    alloc 32768 large
    call phase3
end
