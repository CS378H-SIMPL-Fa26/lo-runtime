# Persistent-set ladder: 128 x 512-byte anchors, identical churn.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func main 0
    alloc 512 anchor0
    alloc 512 anchor1
    alloc 512 anchor2
    alloc 512 anchor3
    alloc 512 anchor4
    alloc 512 anchor5
    alloc 512 anchor6
    alloc 512 anchor7
    alloc 512 anchor8
