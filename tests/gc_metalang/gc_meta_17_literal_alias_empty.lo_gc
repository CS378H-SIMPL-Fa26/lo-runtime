# Literal/dynamic parameters, overwritten alias, empty selection and dropped roots.
# Native sweeps vary heap externally; WASM keeps its default heap.
heap 262144
expect success

func leaf 0
    alloc 16384 scratch
    scratch = null
end

func phase1 0
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
    call leaf
end

func phase2 0
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
    call phase1
end

func phase3 0
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
    call phase2
end

func phase4 0
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
    call phase3
end

func mixed 3
    call phase4
    arg0 = null
end

func main 0
    alloc 1024 original
    alias = original
    alloc 2048 original
    alloc 16 tiny
    tiny = null
    empty = ""
    alloc 4 t0
    call mixed
    original = null
    call phase3
    alias = null
end
