// good test case
// string fields and allocating expression temporaries survive repeated collection
// main method return value: 42
// Author: Liveoak team (Fall 2026)
class Holder(String text;) { String get() { return text; } }
class Main() {
    String churn(int count) {
        String s; s = "";
        while ((0 < count)) { s = ("a" + "b"); count = (count - 1); }
        return s;
    }
    String join(String a, String b) { return (a + b); }
    int main() {
        Holder keep; String s; int i;
        keep = new Holder(("keep" + "me")); i = 0;
        while ((i < 40)) {
            s = this.join(("left" + "right"), this.churn(20));
            if ((!(s = "leftrightab"))) { return 1; } else { ; }
            if ((!(keep.get() = "keepme"))) { return 2; } else { ; }
            i = (i + 1);
        }
        return 42;
    }
}
