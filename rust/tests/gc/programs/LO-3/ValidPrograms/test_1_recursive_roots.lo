// good test case
// caller locals, receivers, recursion, and staged arguments survive every allocation
// main method return value: 42
// Author: Liveoak team (Fall 2026)
class Box(int n; Box next;) {
    int value() { return n; }
    Box tail() { return next; }
    int receiver(Box ignored) { return n; }
}
class Main() {
    Box churn(int count) {
        Box b; b = null;
        while ((0 < count)) { b = new Box(count, null); count = (count - 1); }
        return b;
    }
    int recurse(int depth, Box keep) {
        Box local; int result;
        local = new Box(depth, keep);
        if ((depth = 0)) { result = keep.value(); }
        else { result = this.recurse((depth - 1), keep); }
        if ((!(local.tail() = keep))) { return 1; } else { ; }
        if ((!(local.value() = depth))) { return 2; } else { ; }
        return result;
    }
    int pair(Box a, Box b) { return (a.value() + b.value()); }
    int main() {
        Box keep; keep = new Box(42, null);
        if ((!(this.recurse(12, keep) = 42))) { return 3; } else { ; }
        if ((!((new Box(42, null)).receiver(this.churn(100)) = 42))) { return 4; } else { ; }
        if ((!(this.pair(new Box(41, null), this.churn(100)) = 42))) { return 5; } else { ; }
        if ((!(keep.value() = 42))) { return 6; } else { ; }
        return 42;
    }
}
